# ─────────────────────────────────────────────
# LegalEase — Environment Configuration Example
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For a purely client-side deployment (GitHub Pages),
# the API key is entered by the user at runtime and
# held only in memory — it is never stored or logged.
# ─────────────────────────────────────────────

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_key_here

# Gemini model to use (default: gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-pro

# Generation settings
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# ─────────────────────────────────────────────
# Privacy notice:
# - No document data is stored on any server
# - No conversation history is persisted to disk
# - All processing is in-memory and clears on page close
# - The API key is used only for Gemini requests
# ─────────────────────────────────────────────
